# Public demo mode: the browser reaches the backend through the ngrok tunnel.
# This is what the Vercel deployment must also use.
#
# NEXT_PUBLIC_* values are inlined into the browser bundle, so this has to be
# an address the *visitor's* browser can reach. Restart `npm run dev` after
# changing anything here.
#
# Alternatives:
#   http://localhost:8000       - fastest, but only works on this machine
#   http://192.168.1.11:8000    - same LAN only (needs an inbound firewall
#                                 rule for port 8000; Wi-Fi is on the Public
#                                 profile so it is blocked by default)
NEXT_PUBLIC_API_URL=https://underwent-mothball-abreast.ngrok-free.dev

NEXT_PUBLIC_MAPTILER_KEY=Ssrmgxz3mQBDcDhYerSb
